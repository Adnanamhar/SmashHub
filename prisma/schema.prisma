// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Court {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("Reguler")
  price     Int
  status    String   @default("Tersedia")
  owner_id  String   @default("owner_1")
  created_at DateTime @default(now())
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  level     String   @default("Beginner")
  time      String
  quota     Int
  joined    Int      @default(0)
  owner     String   @default("GOR SmashHub")
  court_id  Int?
  created_at DateTime @default(now())
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  email              String    @unique
  password           String
  full_name          String
  phone              String    @default("")
  role               String    @default("user")
  reset_token        String?
  reset_token_expiry DateTime?
  created_at         DateTime  @default(now())
}